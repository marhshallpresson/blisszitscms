rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Workspaces belong to an owner
    match /workspaces/{workspaceId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Content within a workspace
      match /content/{contentId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
          
        // Comments within content
        match /comments/{commentId} {
          allow read, write: if request.auth != null && 
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
        }
      }
      
      // Ideas within a workspace
      match /ideas/{ideaId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      // Social accounts metadata within a workspace
      match /social_accounts/{accountId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      // Publishing jobs within a workspace
      match /publish_jobs/{jobId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
