rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // OAuth state and credential exchange metadata are server-managed only.
    match /oauth_states/{stateId} {
      allow read, write: if false;
    }

    match /oauth_credentials/{credentialId} {
      allow read, write: if false;
    }

    match /workspaces/{workspaceId} {
      allow read, update, delete: if isWorkspaceOwner(workspaceId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      match /content/{contentId} {
        allow read: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId)
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isWorkspaceOwner(workspaceId)
          && resource.data.workspaceId == workspaceId
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if isWorkspaceOwner(workspaceId);

        match /comments/{commentId} {
          allow read, write: if isWorkspaceOwner(workspaceId);
        }
      }

      match /ideas/{ideaId} {
        allow read, write: if isWorkspaceOwner(workspaceId);
      }

      match /social_accounts/{accountId} {
        allow read: if isWorkspaceOwner(workspaceId);
        allow create, update, delete: if false;
      }

      match /publish_jobs/{jobId} {
        allow read: if isWorkspaceOwner(workspaceId);
        allow create, update, delete: if false;
      }

      match /inbox_threads/{threadId} {
        allow read: if isWorkspaceOwner(workspaceId);
        allow create: if isWorkspaceOwner(workspaceId);
        allow update: if isWorkspaceOwner(workspaceId);
        allow delete: if isWorkspaceOwner(workspaceId);

        match /messages/{messageId} {
          allow read: if isWorkspaceOwner(workspaceId);
          allow create: if isWorkspaceOwner(workspaceId);
          allow update, delete: if false;
        }
      }

      match /analytics_snapshots/{snapshotId} {
        allow read: if isWorkspaceOwner(workspaceId);
        allow create, update, delete: if isWorkspaceOwner(workspaceId);
      }

      match /audit_logs/{logId} {
        allow read: if isWorkspaceOwner(workspaceId);
        allow write: if false;
      }
    }
  }
}
